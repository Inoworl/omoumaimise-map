default_platform(:ios)

platform :ios do
  ENV["FASTLANE_DISABLE_PTY"] = "1"
  ENV["FASTLANE_EXPLICIT_OPEN3"] = "1"
  ENV["FASTLANE_DISABLE_COLORS"] = "1"
  ENV["CI"] = "1"

  desc "Deploy the dev flavor to TestFlight"
  lane :dev do
    ENV["APP_IDENTIFIER"] = required_env("DEV_BUNDLE_ID")
    ENV["SCHEME"] = "dev"
    ENV["CONFIGURATION"] = "Release-dev"

    build_number = resolve_dev_build_number
    ENV["BUILD_NUMBER"] = build_number
    UI.message "Build number: #{build_number}"

    build_and_upload_dev
  end

  private_lane :resolve_dev_build_number do
    override_build_number = ENV["BUILD_NUMBER"].to_s.strip
    return override_build_number unless override_build_number.empty?

    begin
      latest_build_number = latest_testflight_build_number(
        api_key: app_store_connect_api_key_for_ci,
        app_identifier: ENV["APP_IDENTIFIER"],
        version: flutter_marketing_version,
        initial_build_number: 10000
      )

      (latest_build_number.to_i + 1).to_s
    rescue => e
      UI.important "Failed to fetch latest TestFlight build number: #{e.message}"
      Time.now.to_i.to_s
    end
  end

  private_lane :flutter_marketing_version do
    pubspec_path = File.expand_path("../../pubspec.yaml", __dir__)
    version_line = File.readlines(pubspec_path).find { |line| line.start_with?("version:") }
    UI.user_error!("pubspec.yaml version is missing") if version_line.nil?

    version_line.split[1].split("+").first
  end

  private_lane :app_store_connect_api_key_for_ci do
    asc_key_id = required_env("ASC_KEY_ID")
    asc_issuer_id = required_env("ASC_ISSUER_ID")
    asc_api_key_base64 = required_env("ASC_API_KEY_BASE64")
    asc_api_key_path = "./AuthKey.p8"

    require "base64"
    File.binwrite(asc_api_key_path, Base64.decode64(asc_api_key_base64))

    app_store_connect_api_key(
      key_id: asc_key_id,
      issuer_id: asc_issuer_id,
      key_filepath: File.expand_path(asc_api_key_path),
      in_house: false
    )
  end

  private_lane :build_and_upload_dev do
    require "base64"
    require "fileutils"
    require "securerandom"

    cert_password = required_env("CERT_PWD")
    certificate_path = "./certificates.p12"
    File.binwrite(certificate_path, Base64.decode64(required_env("IOS_CERTIFICATE_BASE64")))

    keychain_name = "omoumaimise_fastlane_tmp_keychain"

    begin
      create_keychain(
        name: keychain_name,
        password: cert_password,
        default_keychain: true,
        unlock: true,
        timeout: 3600,
        lock_when_sleeps: false
      )

      import_certificate(
        certificate_path: File.expand_path(certificate_path),
        certificate_password: cert_password,
        keychain_name: keychain_name,
        keychain_password: cert_password
      )

      sh "security list-keychains -s #{keychain_name} ~/Library/Keychains/login.keychain-db"

      flutter_command = flutter_command_for_environment
      build_number = required_env("BUILD_NUMBER")

      sh "cd .. && #{flutter_command} build ios --release --flavor dev --no-codesign --dart-define-from-file=dart_define/dev_dart_define.json --build-number #{build_number}"

      bundle_id = required_env("DEV_BUNDLE_ID")
      provisioning_profile_name = required_env("DEV_PROVISIONING_PROFILE_NAME")
      team_id = required_env("DEVELOPMENT_TEAM")
      ipa_output_name = ENV["IPA_OUTPUT_NAME"].to_s.strip
      ipa_output_name = "Omoumaimise-Dev" if ipa_output_name.empty?

      profile_dir = File.join(ENV["HOME"], "Library/MobileDevice/Provisioning Profiles")
      FileUtils.mkdir_p(profile_dir)
      profile_filename = "#{SecureRandom.uuid}.mobileprovision"
      profile_full_path = File.join(profile_dir, profile_filename)
      File.binwrite(profile_full_path, Base64.decode64(required_env("PROVISIONING_PROFILE_BASE64")))

      build_app(
        workspace: "Runner.xcworkspace",
        scheme: ENV["SCHEME"],
        configuration: ENV["CONFIGURATION"],
        export_method: "app-store",
        output_directory: "./build",
        output_name: "#{ipa_output_name}.ipa",
        buildlog_path: "./build/logs",
        silent: false,
        suppress_xcode_output: false,
        export_options: {
          method: "app-store",
          teamID: team_id,
          signingStyle: "manual",
          provisioningProfiles: {
            bundle_id => provisioning_profile_name
          },
          uploadBitcode: false,
          compileBitcode: false,
          uploadSymbols: true
        }
      )

      upload_to_testflight(
        api_key: app_store_connect_api_key_for_ci,
        ipa: "./build/#{ipa_output_name}.ipa",
        skip_waiting_for_build_processing: true,
        skip_submission: true
      )
    ensure
      begin
        delete_keychain(name: keychain_name)
      rescue => e
        UI.important "Failed to clean up temporary keychain: #{e.message}"
      end
    end
  end

  private_lane :flutter_command_for_environment do
    begin
      sh "which fvm"
      "fvm flutter"
    rescue
      "flutter"
    end
  end

  private_lane :required_env do |name|
    value = ENV[name].to_s.strip
    UI.user_error!("Missing required environment variable: #{name}") if value.empty?
    value
  end
end
